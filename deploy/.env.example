# Copy to .env next to docker-compose.yml and fill in the values.

# Port the site is published on (put HTTPS / a reverse proxy in front of it)
WEB_PORT=8080

# Database
DB_USERNAME=boa
DB_PASSWORD=change-me
DB_DATABASE=boa_db

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# First administrator (super_admin + manager). Created on first start only;
# change the password afterwards and remove it from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Public address of the site (used in invitation and password-reset emails)
WEB_BASE_URL=https://example.org

# Email for invitations and password reset. Leave SMTP_HOST empty to only log emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bible On Air <no-reply@example.org>

# Old Google Site used by 「從舊網站同步」
LEGACY_SITE_URL=https://sites.google.com/view/bibleonair

# Image tag used by docker compose
TAG=latest
