# Application
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=boa_db
# Migrations always run on startup. Set to true only for quick local experiments.
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Uploaded images (mount a volume here in production)
UPLOAD_DIR=uploads

# Legacy Google Site used by the studio's "sync from old site" feature
LEGACY_SITE_URL=https://sites.google.com/view/bibleonair

# First administrator, created by `yarn seed` / the Docker entrypoint if missing
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
